{
  "services": {
    "neo4j": {
      "image": "neo4j:5.26.0-community",
      "environment": {
        "NEO4J_AUTH": "neo4j/${DEMO_DB_PASSWORD:?generated by demo runner}",
        "NEO4J_server_memory_heap_initial__size": "128m",
        "NEO4J_server_memory_heap_max__size": "256m",
        "NEO4J_server_memory_pagecache_size": "128m"
      },
      "ports": ["127.0.0.1:${DEMO_BOLT_PORT}:7687"],
      "volumes": ["model_data:/data"]
    },
    "kafka": {
      "image": "redpandadata/redpanda:v24.2.8",
      "command": ["redpanda", "start", "--overprovisioned", "--smp", "1", "--memory", "512M", "--reserve-memory", "0M", "--check=false", "--kafka-addr", "INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:19092", "--advertise-kafka-addr", "INTERNAL://kafka:9092,EXTERNAL://127.0.0.1:${DEMO_KAFKA_PORT}"],
      "ports": ["127.0.0.1:${DEMO_KAFKA_PORT}:19092"],
      "volumes": ["model_events:/var/lib/redpanda/data"]
    },
    "turbo-db": {
      "image": "ghcr.io/vincentmakes/turbo-ea/db:m1-local-6d9220e",
      "environment": {"POSTGRES_DB":"turboea", "POSTGRES_USER":"turboea", "POSTGRES_PASSWORD":"${DEMO_DB_PASSWORD}", "PGDATA":"/var/lib/postgresql/data"},
      "volumes": ["turbo_data:/var/lib/postgresql/data"],
      "healthcheck": {"test":["CMD", "pg_isready", "-U", "turboea"], "interval":"3s", "timeout":"5s", "retries":40}
    },
    "turbo": {
      "image": "ghcr.io/vincentmakes/turbo-ea/backend:m1-local-6d9220e",
      "environment": {
        "POSTGRES_HOST":"turbo-db", "POSTGRES_PORT":"5432", "POSTGRES_DB":"turboea", "POSTGRES_USER":"turboea",
        "POSTGRES_PASSWORD":"${DEMO_DB_PASSWORD}", "SECRET_KEY":"${DEMO_TURBO_SECRET}",
        "ENVIRONMENT":"development", "SEED_DEMO":"false", "RESET_DB":"false",
        "AI_AUTO_CONFIGURE":"false", "TRUST_PROXY_HEADERS":"false"
      },
      "ports": ["127.0.0.1:${DEMO_TURBO_PORT}:8000"],
      "depends_on": {"turbo-db":{"condition":"service_healthy"}},
      "volumes": ["turbo_files:/app/data"]
    }
  },
  "volumes": {"model_data":{}, "model_events":{}, "turbo_data":{}, "turbo_files":{}}
}
