<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Northstar Trade — order to cash" id="id-0e842edf93f155898fc1d8b272e3884a" version="5.0.0">
  <folder name="Business" id="id-e6bb068ee2e158f390e863b92644a6ab" type="business"/>
  <folder name="Application" id="id-b81463b84db3535e936ab4a74c6e1e34" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Northstar Order Management" id="id-87e5151fb29853a2bdffabd4e3a3084c">
      <documentation>Accepts sales orders, validates prices, reserves stock and coordinates fulfilment and invoicing. Sourcing: in-house
Demo canonical reference: urn:demo:northstar:application:oms</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Northstar Trade Portal" id="id-6d19cecf78cf5a3290b59b5a0bb9235d">
      <documentation>Business customer storefront and order-status portal. Sourcing: in-house
Demo canonical reference: urn:demo:northstar:application:storefront</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sales CRM (SuiteCRM)" id="id-256dd9a321365a89bdff29d0bfe6d1f0">
      <documentation>On-premises CRM: customer accounts and sales opportunities. Sourcing: COTS
Demo canonical reference: urn:demo:northstar:application:crm</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Finance ERP (Odoo)" id="id-01de1e9065045ec38fb1ab9d949ff43e">
      <documentation>On-premises ERP: product prices, invoices and settlement records. Sourcing: COTS
Demo canonical reference: urn:demo:northstar:application:erp</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Warehouse Management (ERPNext)" id="id-f86283d59d7655208535428b062b04c8">
      <documentation>Illustrative on-premises warehouse application: stock, picking and shipment confirmation. Sourcing: COTS
Demo canonical reference: urn:demo:northstar:application:wms</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sales Analytics (Apache Superset)" id="id-22104b12ced25ed2a4df16730a0957a4">
      <documentation>On-premises sales reporting over the curated analytics warehouse. Sourcing: COTS
Demo canonical reference: urn:demo:northstar:application:analytics</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Customer account" id="id-34d2c3daa128562ca4a63564ab9a93c2">
      <documentation>Logical trading account; not equivalent to a physical dataset.
Demo canonical reference: urn:demo:northstar:logical-data:customer</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Product and price" id="id-39ec4bf969335a6d869cb7eb303860f1">
      <documentation>Logical sellable product and agreed list price.
Demo canonical reference: urn:demo:northstar:logical-data:product</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Sales order" id="id-b3ba68c983b05fd28e4d531bf0d2fcda">
      <documentation>Logical customer order including header and lines.
Demo canonical reference: urn:demo:northstar:logical-data:order</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Stock availability" id="id-f5cd591cdc285d79b8e37a9f9e3a65d4">
      <documentation>Logical available inventory and reservations.
Demo canonical reference: urn:demo:northstar:logical-data:stock</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Shipment" id="id-cbe9fa295fe85cbd8113e06dc76408da">
      <documentation>Logical outbound shipment and delivery status.
Demo canonical reference: urn:demo:northstar:logical-data:shipment</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Sales invoice" id="id-530e3d3dd60f536984c9bbd323f16e8f">
      <documentation>Logical invoice and settlement status.
Demo canonical reference: urn:demo:northstar:logical-data:invoice</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Capture sales order" id="id-ab7f25860732599d97f55c4d195b4037">
      <documentation>Validate customer and capture requested order lines.
Demo canonical reference: urn:demo:northstar:function:capture</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Validate order pricing" id="id-ecdbd7ada38f5c1ab12649eabc7186c5">
      <documentation>Check agreed prices and calculate order value.
Demo canonical reference: urn:demo:northstar:function:price</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Reserve available stock" id="id-d699ac180dd85d72bc2ed9d5a9a8b674">
      <documentation>Request reservation from the warehouse application.
Demo canonical reference: urn:demo:northstar:function:reserve</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Coordinate fulfilment" id="id-88bee996429e52b3998c65a12965dbc6">
      <documentation>Release accepted order to the warehouse and track shipment.
Demo canonical reference: urn:demo:northstar:function:fulfil</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Request sales invoice" id="id-bf54dcc824895bf4b2bc45e9fe8dfa7f">
      <documentation>Request invoice creation in the finance ERP after shipment.
Demo canonical reference: urn:demo:northstar:function:invoice</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Provide order status" id="id-5178680c3e675578a1937d2ae35d942c">
      <documentation>Expose order state to the trade portal.
Demo canonical reference: urn:demo:northstar:function:status</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Sales order submission" id="id-b05b0ffdc0a951db8bb8ad839c9517de">
      <documentation>Service exposed by the in-house order application.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Order tracking" id="id-884a61518359597a8c42d5bc25ed6690">
      <documentation>Service exposed by the in-house order application.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-c28ea78e5c2f5983a522a435c08ce725" type="technology">
    <element xsi:type="archimate:Node" name="Trade application cluster" id="id-d403b51f7a615526ab436216bb554774">
      <documentation>On-premises Kubernetes runtime; illustrative deployment dependency, not a discovered cluster.
Demo canonical reference: urn:demo:northstar:infrastructure:kubernetes</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Operational PostgreSQL service" id="id-0e775a67372858d08a3028b8c6ae71a2">
      <documentation>On-premises database service with separate application databases.
Demo canonical reference: urn:demo:northstar:infrastructure:postgres</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Packaged-application MariaDB service" id="id-87ea2445e05b5e09b76794f417cf547d">
      <documentation>Illustrative on-premises database service for the CRM and warehouse applications; catalogued using the MySQL-compatible platform.
Demo canonical reference: urn:demo:northstar:infrastructure:mariadb</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Trade event broker" id="id-d2f886c8225956f4b7850fe5c2ab578a">
      <documentation>On-premises Kafka service carrying order and shipment events.
Demo canonical reference: urn:demo:northstar:infrastructure:kafka</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Trade analytics warehouse" id="id-ba4b3b66832d5dad9fb3ce087be7860a">
      <documentation>On-premises PostgreSQL analytical store.
Demo canonical reference: urn:demo:northstar:infrastructure:warehouse</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Trade virtual machine platform" id="id-609d9bc0830f5327959f37a6c2f2aaf9">
      <documentation>On-premises virtual machines hosting packaged business applications.
Demo canonical reference: urn:demo:northstar:infrastructure:virtualization</documentation>
    </element>
  </folder>
