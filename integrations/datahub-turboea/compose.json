{
  "services": {
    "gms": {
      "depends_on": {
        "system-update": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "environment": {
        "ALTERNATE_MCP_VALIDATION": "true",
        "CONFIG_ENTITY_REGISTRY_USE_OPTIMIZED_LOADING": "true",
        "DATAHUB_BASE_PATH": "/",
        "DATAHUB_GMS_BASE_PATH": "/",
        "DATAHUB_OBJECT_STORAGE_URI": "file:///tmp/datahub-object-storage",
        "DATAHUB_SERVER_TYPE": "quickstart",
        "DATAHUB_SYSTEM_CLIENT_SECRET": "${DATAHUB_SYSTEM_CLIENT_SECRET:?Run scripts/local.py init first}",
        "DATAHUB_TELEMETRY_ENABLED": "false",
        "DATAHUB_TOKEN_SERVICE_SALT": "${DATAHUB_TOKEN_SERVICE_SALT:?Run scripts/local.py init first}",
        "DATAHUB_TOKEN_SERVICE_SIGNING_KEY": "${DATAHUB_TOKEN_SERVICE_SIGNING_KEY:?Run scripts/local.py init first}",
        "DATAHUB_UPGRADE_HISTORY_KAFKA_CONSUMER_GROUP_ID": "generic-duhe-consumer-job-client-gms",
        "DEV_TOOLING_ENABLED": "false",
        "EBEAN_DATASOURCE_DRIVER": "com.mysql.jdbc.Driver",
        "EBEAN_DATASOURCE_HOST": "mysql:3306",
        "EBEAN_DATASOURCE_PASSWORD": "${DATAHUB_DB_PASSWORD:?Run init}",
        "EBEAN_DATASOURCE_URL": "jdbc:mysql://mysql:3306/datahub?verifyServerCertificate=false&useSSL=true&useUnicode=yes&characterEncoding=UTF-8&enabledTLSProtocols=TLSv1.2",
        "EBEAN_DATASOURCE_USERNAME": "root",
        "ELASTICSEARCH_HOST": "search",
        "ELASTICSEARCH_IMPLEMENTATION": "opensearch",
        "ELASTICSEARCH_INDEX_BUILDER_MAPPINGS_REINDEX": "true",
        "ELASTICSEARCH_INDEX_BUILDER_SETTINGS_REINDEX": "true",
        "ELASTICSEARCH_LIMIT_RESULTS_STRICT": "true",
        "ELASTICSEARCH_PORT": "9200",
        "ELASTICSEARCH_PROTOCOL": "http",
        "ELASTICSEARCH_USE_SSL": "false",
        "ENTITY_REGISTRY_CONFIG_PATH": "/datahub/datahub-gms/resources/entity-registry.yml",
        "ENTITY_SERVICE_ENABLE_RETENTION": "true",
        "ENTITY_VERSIONING_ENABLED": "true",
        "ES_BULK_REFRESH_POLICY": "NONE",
        "EXTRACT_JAR_ENABLED": "true",
        "GMS_LIFECYCLE_TIMEOUT": "65s",
        "GRAPH_SERVICE_DIFF_MODE_ENABLED": "true",
        "GRAPH_SERVICE_IMPL": "elasticsearch",
        "GRAPHQL_SHAPE_LOGGING_DURATION_THRESHOLD_MS": "3000",
        "GRAPHQL_SHAPE_LOGGING_ENABLED": "false",
        "GRAPHQL_SHAPE_LOGGING_ERROR_COUNT_THRESHOLD": "1",
        "GRAPHQL_SHAPE_LOGGING_FIELD_COUNT_THRESHOLD": "100",
        "GRAPHQL_SHAPE_LOGGING_RESPONSE_SIZE_THRESHOLD_BYTES": "1048576",
        "JAVA_OPTS": "-Xms1g -Xmx1g",
        "KAFKA_BOOTSTRAP_SERVER": "broker:29092",
        "KAFKA_SCHEMAREGISTRY_URL": "http://datahub-gms:8080/schema-registry/api/",
        "LOG_AGGREGATOR_ENDPOINT": "",
        "MAE_CONSUMER_ENABLED": "true",
        "MCE_CONSUMER_ENABLED": "true",
        "MCL_CONSUMER_BATCH_ENABLED": "true",
        "MCP_CONSUMER_BATCH_ENABLED": "true",
        "METADATA_SERVICE_AUTH_ENABLED": "true",
        "PE_CONSUMER_ENABLED": "true",
        "POLICY_CACHE_REFRESH_INTERVAL_SECONDS": "5",
        "SCHEMA_REGISTRY_TYPE": "INTERNAL",
        "SEARCH_BAR_API_VARIANT": "SEARCH_ACROSS_ENTITIES",
        "SERVER_SHUTDOWN_MODE": "immediate",
        "SHOW_HAS_SIBLINGS_FILTER": "true",
        "SHOW_HOME_PAGE_REDESIGN": "true",
        "SHOW_INGESTION_PAGE_REDESIGN": "true",
        "SHOW_SEARCH_BAR_AUTOCOMPLETE_REDESIGN": "true",
        "STRICT_URN_VALIDATION_ENABLED": "true",
        "THEME_V2_DEFAULT": "true",
        "UI_INGESTION_ENABLED": "false",
        "USAGE_AGGREGATION_ALIGNMENT_PERIOD_SECONDS": "3600",
        "USAGE_AGGREGATION_ENABLED": "true",
        "USAGE_AGGREGATION_FLUSH_INTERVAL_SECONDS": "30",
        "USAGE_AGGREGATION_INCLUDE_AGENT_NAME": "true",
        "VIEW_AUTHORIZATION_ENABLED": "true",
        "ZDU_STAGE_10": "true",
        "ZDU_STAGE_20": "true",
        "UI_INGESTION_DEFAULT_CLI_VERSION": "1.8.0",
        "CLI_TELEMETRY_ENABLED": "false",
        "ENABLE_THIRD_PARTY_LOGGING": "false",
        "REST_API_AUTHORIZATION_ENABLED": "true",
        "GUEST_AUTHENTICATION_ENABLED": "false",
        "DATAHUB_BASE_URL": "http://127.0.0.1:${DATAHUB_FRONTEND_PORT:-19002}"
      },
      "hostname": "datahub-gms",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -sS --fail http://datahub-gms:8080/health"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 30,
        "start_period": "120s"
      },
      "image": "${DATAHUB_IMAGE_REGISTRY:-acryldata}/datahub-gms:v1.8.0",
      "ports": [
        {
          "target": 8080,
          "published": "${DATAHUB_GMS_PORT:-18080}",
          "host_ip": "127.0.0.1"
        }
      ]
    },
    "frontend": {
      "depends_on": {
        "system-update": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "gms": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "DATAHUB_APP_VERSION": "v1.8.0",
        "DATAHUB_BASE_PATH": "/",
        "DATAHUB_GMS_BASE_PATH": "/",
        "DATAHUB_GMS_HOST": "datahub-gms",
        "DATAHUB_GMS_PORT": "8080",
        "DATAHUB_PLAY_MEM_BUFFER_SIZE": "10MB",
        "DATAHUB_SECRET": "${DATAHUB_FRONTEND_SECRET:?Run init}",
        "DATAHUB_SYSTEM_CLIENT_SECRET": "${DATAHUB_SYSTEM_CLIENT_SECRET:?Run scripts/local.py init first}",
        "DATAHUB_TRACKING_TOPIC": "DataHubUsageEvent_v1",
        "ELASTIC_CLIENT_HOST": "elasticsearch",
        "ELASTIC_CLIENT_PORT": "9200",
        "FRONTEND_BEFORE_SERVICE_UNBIND_TIMEOUT": "10s",
        "FRONTEND_GRACEFUL_SHUTDOWN_ENABLED": "false",
        "FRONTEND_SERVICE_REQUESTS_DONE_TIMEOUT": "65s",
        "FRONTEND_SERVICE_STOP_TIMEOUT": "15s",
        "JAVA_OPTS": "-Xms512m -Xmx512m -Dhttp.port=9002 -Dconfig.file=datahub-frontend/conf/application.conf -Djava.security.auth.login.config=datahub-frontend/conf/jaas.conf -Dlogback.configurationFile=datahub-frontend/conf/logback.xml -Dlogback.debug=false -Dpidfile.path=/dev/null",
        "KAFKA_BOOTSTRAP_SERVER": "broker:29092",
        "LOG_AGGREGATOR_ENDPOINT": "",
        "PLAY_HTTP_CONTEXT": "/",
        "THEME_V2_DEFAULT": "true",
        "METADATA_SERVICE_AUTH_ENABLED": "true",
        "GUEST_AUTHENTICATION_ENABLED": "false",
        "AUTH_NATIVE_ENABLED": "false",
        "AUTH_JAAS_ENABLED": "true",
        "DATAHUB_TELEMETRY_ENABLED": "false"
      },
      "hostname": "datahub-frontend-react",
      "image": "${DATAHUB_IMAGE_REGISTRY:-acryldata}/datahub-frontend-react:v1.8.0",
      "ports": [
        {
          "target": 9002,
          "published": "${DATAHUB_FRONTEND_PORT:-19002}",
          "host_ip": "127.0.0.1"
        }
      ],
      "volumes": [
        "${DATAHUB_SECRETS_DIR:?Run init}/user.props:/datahub-frontend/conf/user.props:ro"
      ]
    },
    "broker": {
      "command": [
        "/bin/bash",
        "-c",
        "# Generate KRaft clusterID\nfile_path=\"/var/lib/kafka/data/clusterID\"\n\nif [ ! -f \"$$file_path\" ]; then\n   /bin/kafka-storage random-uuid > $$file_path\n   echo \"Cluster id has been created...\"\n   # KRaft required step: Format the storage directory with a new cluster ID\n   kafka-storage format --ignore-formatted -t $$(cat \"$$file_path\") -c /etc/kafka/kafka.properties\nfi\n\nexport CLUSTER_ID=$$(cat \"$$file_path\")\necho \"CLUSTER_ID=$$CLUSTER_ID\"\n\n/etc/confluent/docker/run\n"
      ],
      "environment": {
        "KAFKA_ADVERTISED_LISTENERS": "BROKER://broker:29092",
        "KAFKA_BROKER_ID": "1",
        "KAFKA_CONFLUENT_SUPPORT_METRICS_ENABLE": "false",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@broker:39092",
        "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS": "0",
        "KAFKA_HEAP_OPTS": "-Xms512m -Xmx512m",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "BROKER",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,BROKER:PLAINTEXT",
        "KAFKA_LISTENERS": "BROKER://broker:29092,CONTROLLER://broker:39092",
        "KAFKA_LOG4J_LOGGERS": "org.apache.kafka.image.loader.MetadataLoader=WARN",
        "KAFKA_MAX_MESSAGE_BYTES": "5242880",
        "KAFKA_MESSAGE_MAX_BYTES": "5242880",
        "KAFKA_NODE_ID": "1",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_PROCESS_ROLES": "controller, broker",
        "KAFKA_ZOOKEEPER_CONNECT": null
      },
      "hostname": "broker",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "kafka-broker-api-versions --bootstrap-server broker:29092 >/dev/null 2>&1"
        ],
        "timeout": "10s",
        "interval": "5s",
        "retries": 12,
        "start_period": "1m0s"
      },
      "image": "confluentinc/cp-kafka:8.2.2",
      "volumes": [
        "broker:/var/lib/kafka/data"
      ]
    },
    "mysql": {
      "command": [
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_bin",
        "--default-authentication-plugin=caching_sha2_password"
      ],
      "environment": {
        "MYSQL_DATABASE": "datahub",
        "MYSQL_PASSWORD": "${DATAHUB_DB_PASSWORD:?Run init}",
        "MYSQL_ROOT_HOST": "%",
        "MYSQL_ROOT_PASSWORD": "${DATAHUB_DB_PASSWORD:?Run init}",
        "MYSQL_USER": "datahub"
      },
      "hostname": "mysql",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "mysqladmin ping -h mysql -u $$MYSQL_USER --password=$$MYSQL_PASSWORD"
        ],
        "timeout": "10s",
        "interval": "2s",
        "retries": 5,
        "start_period": "20s"
      },
      "image": "mysql:8.2",
      "restart": "on-failure",
      "volumes": [
        "mysql:/var/lib/mysql"
      ]
    },
    "search": {
      "environment": {
        "DISABLE_SECURITY_PLUGIN": "true",
        "ES_JAVA_OPTS": "-Xms256m -Xmx512m -Dlog4j2.formatMsgNoLookups=true",
        "OPENSEARCH_JAVA_OPTS": "-Xms768m -Xmx1024m -Dlog4j2.formatMsgNoLookups=true",
        "discovery.type": "single-node"
      },
      "hostname": "search",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -sS --fail \"http://search:$${DATAHUB_ELASTIC_PORT:-9200}/_cluster/health?wait_for_status=yellow&timeout=0s\""
        ],
        "timeout": "15s",
        "interval": "5s",
        "retries": 10,
        "start_period": "1m0s"
      },
      "image": "opensearchproject/opensearch:2.19.3",
      "volumes": [
        "search:/usr/share/opensearch/data"
      ]
    },
    "system-update": {
      "command": [
        "-u",
        "SystemUpdate"
      ],
      "depends_on": {
        "broker": {
          "condition": "service_healthy",
          "required": true
        },
        "mysql": {
          "condition": "service_healthy",
          "required": true
        },
        "search": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "BACKFILL_BROWSE_PATHS_V2": "true",
        "CREATE_USER": "false",
        "CREATE_USER_PASSWORD": "datahub",
        "CREATE_USER_USERNAME": "datahub",
        "DATAHUB_BASE_PATH": "/",
        "DATAHUB_GMS_BASE_PATH": "/",
        "DATAHUB_GMS_HOST": "datahub-gms",
        "DATAHUB_GMS_PORT": "8080",
        "DATAHUB_PRECREATE_TOPICS": "true",
        "DATAHUB_SQL_SETUP_ENABLED": "true",
        "DATAHUB_SYSTEM_CLIENT_SECRET": "${DATAHUB_SYSTEM_CLIENT_SECRET:?Run scripts/local.py init first}",
        "DATAHUB_TOKEN_SERVICE_SALT": "${DATAHUB_TOKEN_SERVICE_SALT:?Run scripts/local.py init first}",
        "DATAHUB_TOKEN_SERVICE_SIGNING_KEY": "${DATAHUB_TOKEN_SERVICE_SIGNING_KEY:?Run scripts/local.py init first}",
        "EBEAN_DATASOURCE_DRIVER": "com.mysql.jdbc.Driver",
        "EBEAN_DATASOURCE_HOST": "mysql:3306",
        "EBEAN_DATASOURCE_PASSWORD": "${DATAHUB_DB_PASSWORD:?Run init}",
        "EBEAN_DATASOURCE_URL": "jdbc:mysql://mysql:3306/datahub?verifyServerCertificate=false&useSSL=true&useUnicode=yes&characterEncoding=UTF-8&enabledTLSProtocols=TLSv1.2",
        "EBEAN_DATASOURCE_USERNAME": "root",
        "ELASTICSEARCH_BUILD_INDICES_CLONE_INDICES": "false",
        "ELASTICSEARCH_HOST": "search",
        "ELASTICSEARCH_IMPLEMENTATION": "opensearch",
        "ELASTICSEARCH_INDEX_BUILDER_MAPPINGS_REINDEX": "true",
        "ELASTICSEARCH_INDEX_BUILDER_REFRESH_INTERVAL_SECONDS": "3",
        "ELASTICSEARCH_INDEX_BUILDER_SETTINGS_REINDEX": "true",
        "ELASTICSEARCH_PORT": "9200",
        "ELASTICSEARCH_PROTOCOL": "http",
        "ELASTICSEARCH_USE_SSL": "false",
        "ENTITY_REGISTRY_CONFIG_PATH": "/datahub/datahub-gms/resources/entity-registry.yml",
        "ENTITY_VERSIONING_ENABLED": "true",
        "GRAPH_SERVICE_IMPL": "elasticsearch",
        "KAFKA_BOOTSTRAP_SERVER": "broker:29092",
        "KAFKA_SCHEMAREGISTRY_URL": "http://datahub-gms:8080/schema-registry/api/",
        "LOG_AGGREGATOR_ENDPOINT": "",
        "PARTITIONS": "3",
        "REPROCESS_DEFAULT_BROWSE_PATHS_V2": "false",
        "SCHEMA_REGISTRY_SYSTEM_UPDATE": "true",
        "SCHEMA_REGISTRY_TYPE": "INTERNAL",
        "SPRING_KAFKA_PROPERTIES_AUTO_REGISTER_SCHEMAS": "true",
        "SPRING_KAFKA_PROPERTIES_USE_LATEST_VERSION": "true",
        "USE_CONFLUENT_SCHEMA_REGISTRY": "false",
        "VIEW_AUTHORIZATION_ENABLED": "true",
        "ZDU_STAGE_10": "true",
        "ZDU_STAGE_20": "true",
        "DATAHUB_TELEMETRY_ENABLED": "false",
        "CLI_TELEMETRY_ENABLED": "false",
        "ENABLE_THIRD_PARTY_LOGGING": "false"
      },
      "hostname": "datahub-system-update",
      "image": "${DATAHUB_IMAGE_REGISTRY:-acryldata}/datahub-upgrade:v1.8.0"
    }
  },
  "volumes": {
    "mysql": {},
    "broker": {},
    "search": {}
  }
}
